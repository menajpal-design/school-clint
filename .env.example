NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: client-side configuration for CSRF header name (server sets cookie name)
# The client does not store secrets in env; instead it should fetch `/api/csrf/token` and send
# the CSRF token in the header defined by the server (default: x-csrf-token).
NEXT_PUBLIC_CSRF_HEADER_NAME=x-csrf-token