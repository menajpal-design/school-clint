# ============================================================
# Easy School Client (Next.js) — Environment Variables Template
# ============================================================
# SETUP: Copy this file → rename it to .env.local → fill in values
#        cp .env.local.example .env.local
# ============================================================

# --------------------------
# API Server URL
# --------------------------
# Local development (default — server runs on port 5000)
API_TARGET=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_TARGET=http://localhost:5000
NEXT_PUBLIC_CSRF_HEADER_NAME=x-csrf-token

# Production example:
# API_TARGET=https://your-server.herokuapp.com
# NEXT_PUBLIC_API_URL=https://your-server.herokuapp.com/api
# NEXT_PUBLIC_API_TARGET=https://your-server.herokuapp.com

# --------------------------
# Optional
# --------------------------
